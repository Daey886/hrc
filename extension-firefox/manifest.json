{
  "manifest_version": 2,
  "name": "Hermes Remote Control (Firefox)",
  "version": "1.0.0",
  "description": "Allow Hermes agent to remotely control Firefox. Companion to the Chrome/Edge version - same HTTP API, same relay server.",
  "permissions": [
    "tabs",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["websocket.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Hermes Remote Control",
    "default_icon": {
      "16": "icon16.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hrc@hermes-remote-control",
      "strict_min_version": "115.0"
    }
  }
}
